{
  "name": "dnscheck-monorepo",
  "version": "1.0.0",
  "description": "DNSCheck - Global DNS Propagation & Record Misconfiguration Verifier",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "dns",
    "propagation",
    "security",
    "sre",
    "monitoring",
    "spf",
    "dmarc",
    "cname"
  ],
  "author": "CODEBEGUN HACKZEN 2026 Team",
  "license": "MIT"
}
