# DNSCheck Environment Configuration

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/dnscheck

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# DNS Engine Settings
DNS_QUERY_TIMEOUT_MS=3000
DNS_MAX_CONCURRENCY=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Rate Limiting
GLOBAL_RATE_LIMIT=120
SCAN_RATE_LIMIT_PER_MINUTE=20
PER_DOMAIN_COOLDOWN_SECONDS=5

# Monitoring Cron
MONITORING_CRON_SCHEDULE=* * * * *
